{
  "name": "esreader-desktop",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "A quiet desktop reader for published Cerita stories.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n ui,electron -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:ui && npm run build:electron",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.fauzulazim.esreader",
    "productName": "esReader",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/esreader-icon.ico",
      "artifactName": "esReader-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "LRecodex",
      "repo": "esReader"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
